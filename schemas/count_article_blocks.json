{
  "name": "count_article_blocks",
  "description": "Count article blocks matching substring and block-type filters without returning the blocks.",
  "inputSchema": {
    "properties": {
      "article_id": {
        "minLength": 1,
        "type": "string"
      },
      "search": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "types": {
        "anyOf": [
          {
            "items": {
              "enum": [
                "paragraph",
                "header",
                "list",
                "image",
                "quote",
                "code",
                "delimiter",
                "table"
              ],
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "article_id"
    ],
    "type": "object"
  },
  "outputSchema": {
    "additionalProperties": true,
    "type": "object"
  }
}

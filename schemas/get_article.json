{
  "name": "get_article",
  "description": "Retrieve an article and, optionally, its block data.",
  "inputSchema": {
    "properties": {
      "article_id": {
        "minLength": 1,
        "type": "string"
      },
      "include_block_data": {
        "default": false,
        "type": "boolean"
      }
    },
    "required": [
      "article_id"
    ],
    "type": "object"
  },
  "outputSchema": {
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "body": {
        "anyOf": [
          {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "extraData": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "dateCreated": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "dateUpdated": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "hasInvites": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "id",
      "name"
    ],
    "type": "object"
  }
}

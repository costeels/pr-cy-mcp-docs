{
  "name": "get_keywords",
  "description": "List project keywords, keyword groups and target URLs.",
  "inputSchema": {
    "properties": {
      "project_id": {
        "exclusiveMinimum": 0,
        "type": "integer"
      },
      "limit": {
        "default": 100,
        "maximum": 1000,
        "minimum": 1,
        "type": "integer"
      },
      "offset": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "project_id"
    ],
    "type": "object"
  },
  "outputSchema": {
    "$defs": {
      "Keyword": {
        "properties": {
          "id": {
            "type": "integer"
          },
          "keyword": {
            "type": "string"
          },
          "groups": {
            "items": {
              "$ref": "#/$defs/KeywordGroup"
            },
            "type": "array"
          },
          "target_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "id",
          "keyword"
        ],
        "type": "object"
      },
      "KeywordGroup": {
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      }
    },
    "properties": {
      "result": {
        "items": {
          "$ref": "#/$defs/Keyword"
        },
        "type": "array"
      }
    },
    "required": [
      "result"
    ],
    "type": "object"
  }
}

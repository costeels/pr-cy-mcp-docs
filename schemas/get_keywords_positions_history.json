{
  "name": "get_keywords_positions_history",
  "description": "Retrieve historical project keyword rankings for a selected search setting.",
  "inputSchema": {
    "properties": {
      "search_options_id": {
        "exclusiveMinimum": 0,
        "type": "integer"
      },
      "date_from": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "date_to": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "limit": {
        "default": 100,
        "maximum": 1000,
        "minimum": 1,
        "type": "integer"
      },
      "offset": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "search_options_id"
    ],
    "type": "object"
  },
  "outputSchema": {
    "$defs": {
      "KeywordPositionsHistoryItem": {
        "properties": {
          "id": {
            "type": "integer"
          },
          "keyword": {
            "type": "string"
          },
          "wordstat": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "positions": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "required": [
          "id",
          "keyword"
        ],
        "type": "object"
      }
    },
    "properties": {
      "result": {
        "items": {
          "$ref": "#/$defs/KeywordPositionsHistoryItem"
        },
        "type": "array"
      }
    },
    "required": [
      "result"
    ],
    "type": "object"
  }
}

{
  "name": "get_keywords_summaries",
  "description": "Retrieve project keyword summaries for a selected search setting.",
  "inputSchema": {
    "properties": {
      "project_id": {
        "exclusiveMinimum": 0,
        "type": "integer"
      },
      "search_options_id": {
        "exclusiveMinimum": 0,
        "type": "integer"
      },
      "limit": {
        "default": 100,
        "maximum": 1000,
        "minimum": 1,
        "type": "integer"
      },
      "offset": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "project_id",
      "search_options_id"
    ],
    "type": "object"
  },
  "outputSchema": {
    "$defs": {
      "KeywordSummary": {
        "properties": {
          "keyword_id": {
            "type": "integer"
          },
          "keyword": {
            "type": "string"
          },
          "position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "diff": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "wordstat": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "date_updated": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "relevant_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "keyword_id",
          "keyword"
        ],
        "type": "object"
      }
    },
    "properties": {
      "result": {
        "items": {
          "$ref": "#/$defs/KeywordSummary"
        },
        "type": "array"
      }
    },
    "required": [
      "result"
    ],
    "type": "object"
  }
}

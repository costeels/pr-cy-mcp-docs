{
  "name": "get_metrika_pages_report",
  "description": "Retrieve a Yandex Metrika page report with selected metrics, dimensions and filters.",
  "inputSchema": {
    "properties": {
      "project_id": {
        "exclusiveMinimum": 0,
        "type": "integer"
      },
      "metrics": {
        "default": [
          "ym:s:users",
          "ym:s:visits"
        ],
        "items": {
          "type": "string"
        },
        "maxItems": 20,
        "minItems": 1,
        "type": "array"
      },
      "dimensions": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": [
          "ym:s:startURL"
        ]
      },
      "date_from": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "date_to": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "sort": {
        "default": [],
        "items": {
          "type": "string"
        },
        "maxItems": 5,
        "minItems": 0,
        "type": "array"
      },
      "limit": {
        "default": 15,
        "exclusiveMinimum": 0,
        "maximum": 100,
        "type": "integer"
      },
      "filters": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "goal_ids": {
        "anyOf": [
          {
            "items": {
              "type": "integer"
            },
            "maxItems": 10,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "project_id"
    ],
    "type": "object"
  },
  "outputSchema": {
    "additionalProperties": true,
    "type": "object"
  }
}

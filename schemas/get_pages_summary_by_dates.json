{
  "name": "get_pages_summary_by_dates",
  "description": "Retrieve historical clicks, impressions and positions grouped by day, week or month.",
  "inputSchema": {
    "properties": {
      "project_id": {
        "exclusiveMinimum": 0,
        "type": "integer"
      },
      "period": {
        "default": "day",
        "enum": [
          "day",
          "week",
          "month"
        ],
        "type": "string"
      },
      "date_from": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "date_to": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "url": {
        "anyOf": [
          {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "project_id"
    ],
    "type": "object"
  },
  "outputSchema": {
    "properties": {
      "result": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "type": "array"
      }
    },
    "required": [
      "result"
    ],
    "type": "object"
  }
}

{
  "name": "get_project_keyword_groups",
  "description": "List keyword groups in a PR-CY project.",
  "inputSchema": {
    "properties": {
      "project_id": {
        "exclusiveMinimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "project_id"
    ],
    "type": "object"
  },
  "outputSchema": {
    "$defs": {
      "ProjectKeywordGroup": {
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "date_created": {
            "type": "string"
          },
          "keywords_count": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "date_created",
          "keywords_count"
        ],
        "type": "object"
      }
    },
    "properties": {
      "result": {
        "items": {
          "$ref": "#/$defs/ProjectKeywordGroup"
        },
        "type": "array"
      }
    },
    "required": [
      "result"
    ],
    "type": "object"
  }
}

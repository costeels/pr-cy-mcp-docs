{
  "name": "list_articles",
  "description": "List the articles available to the connected user.",
  "inputSchema": {
    "properties": {
      "limit": {
        "default": 10,
        "maximum": 50,
        "minimum": 1,
        "type": "integer"
      },
      "offset": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
      },
      "sort": {
        "default": "-dateUpdated",
        "type": "string"
      }
    },
    "type": "object"
  },
  "outputSchema": {
    "$defs": {
      "ArticleShort": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "dateCreated": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "dateUpdated": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "hasInvites": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      }
    },
    "properties": {
      "result": {
        "items": {
          "$ref": "#/$defs/ArticleShort"
        },
        "type": "array"
      }
    },
    "required": [
      "result"
    ],
    "type": "object"
  }
}

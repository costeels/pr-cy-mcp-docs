{
  "name": "update_group_keywords",
  "description": "Update the assignment of keyword IDs to a keyword group.",
  "inputSchema": {
    "properties": {
      "group_id": {
        "exclusiveMinimum": 0,
        "type": "integer"
      },
      "keyword_ids": {
        "items": {
          "type": "integer"
        },
        "maxItems": 100,
        "minItems": 0,
        "type": "array"
      }
    },
    "required": [
      "group_id",
      "keyword_ids"
    ],
    "type": "object"
  },
  "outputSchema": {
    "properties": {
      "status": {
        "enum": [
          "success",
          "error"
        ],
        "type": "string"
      }
    },
    "required": [
      "status"
    ],
    "type": "object"
  }
}
